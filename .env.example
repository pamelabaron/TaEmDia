# === Copie este arquivo para ".env" e preencha os valores reais ===
# (o arquivo .env NÃO vai para o Git — ver .gitignore)

# Ambiente: "desenvolvimento" ou "producao".
# Em produção a aplicação valida os segredos abaixo e se recusa a subir se
# algum deles estiver inseguro.
AMBIENTE=desenvolvimento

# Banco de dados PostgreSQL
POSTGRES_USER=taemdia
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=taemdia
# URL usada pelo backend (host "db" = nome do serviço no docker-compose)
DATABASE_URL=postgresql+psycopg://taemdia:troque_esta_senha@db:5432/taemdia

# Autenticação (JWT). Em produção use uma chave longa e aleatória (32+ caracteres).
JWT_SECRET=gere_uma_chave_secreta_longa_e_aleatoria
JWT_EXPIRE_MINUTES=1440

# Google OAuth 2.0 (obtidos no Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Endereço do frontend. Aceita várias origens separadas por vírgula.
# É usado no redirecionamento do login e na liberação de CORS.
FRONTEND_URL=http://localhost:4200

# Evolution API (WhatsApp). Com a chave em branco, o sistema roda em modo
# simulador: registra as mensagens sem enviá-las. Ver docs/whatsapp-conectar.md
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=taemdia

# Segredo que autentica as chamadas ao webhook do WhatsApp.
# Obrigatório em produção: sem ele, qualquer um poderia forjar respostas.
WEBHOOK_TOKEN=

# Agendador de tarefas em segundo plano (varredura de cobranças e resumo diário)
AGENDADOR_ATIVO=true
