# === Copie este arquivo para ".env" e preencha os valores reais ===
# (o arquivo .env NÃO vai para o Git — ver .gitignore)

# Banco de dados PostgreSQL
POSTGRES_USER=taemdia
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=taemdia
# URL usada pelo backend para falar com o banco (host "db" = nome do serviço no docker-compose)
DATABASE_URL=postgresql+psycopg://taemdia:troque_esta_senha@db:5432/taemdia

# Autenticação (JWT)
JWT_SECRET=gere_uma_chave_secreta_longa_e_aleatoria
JWT_EXPIRE_MINUTES=1440

# Google OAuth 2.0 (obtidos no Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Evolution API (WhatsApp) — usado a partir do Sprint 5
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=

# Endereço do frontend Angular
FRONTEND_URL=http://localhost:4200
